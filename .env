VITE_API_URL=http://localhost:8080/api

# ── Landings del Pack Básico (tiamdigital.com/pack/familias y /pack/profesionales) ──
#
# Los reales se cargan en Vercel (Project Settings > Environment Variables) o se reemplazan acá.
# Las variables de Vercel pisan las de este archivo. Cambiar una variable exige un nuevo build.
#
# Ninguna página muestra [[marcadores]]: si un dato real falta, el espacio se oculta o queda un texto neutro.
# Para que eso no llegue a producción, con PACK_STRICT=1 el build FALLA mientras falte un dato de la lista
# "OBLIGATORIOS PARA PUBLICAR" o siga prendido VITE_PACK_PREVIEW. La lista completa de pendientes está en
# "Proyecto Digitales/pack/landings-pendientes.md" (fuera de este repo).

# Vista previa: con un valor (1) las landings muestran la cinta "Vista previa: datos provisorios" y el
# build de producción (PACK_STRICT=1) falla. Dejar vacío cuando precios, garantía y ofertas sean los definitivos.
VITE_PACK_PREVIEW=1

# ── Precios, ofertas y garantía (PROVISORIOS) ──
# Precio final en pesos argentinos, con punto de miles. Salen de acá y de ningún otro lugar: el HTML no tiene números escritos.
VITE_PACK_PRICE=14.990
# Cuadernos TIAM (tiamdigital.com/cuadernos: 4 cuadernos, 120 ejercicios para hacer solos). Precio de la colección: DEFINITIVO (lo confirmó el dueño el 2026-10-19).
# Complemento opcional: el PRIMER mes del Desafío de 30 días, al comprar junto con los cuadernos, cuesta lo que dice VITE_PACK_CUADERNOS_GAMES_PRICE (15.000):
# el total es 35.000. Su precio normal (20.000) sale de PRICE_ARS en Desafio30DiasPage.tsx. Los meses siguientes se compran aparte, sin débito automático.
# Lo que sigue provisorio en la página (garantía, contacto, razón social) está más abajo.
VITE_PACK_CUADERNOS_PRICE=20.000
VITE_PACK_CUADERNOS_GAMES_PRICE=15.000
# Bonos de los cuadernos (opcional, vacío = sin bonos): `Título | descripción corta ;; Otro título | otra descripción`. Aparecen en "Todo lo que recibís", sin ningún valor en pesos.
VITE_PACK_CUADERNOS_BONUSES=
# Oferta al pagar (sobre todo familias): un mes de juegos interactivos (Desafío de 30 días) por este monto.
# Su precio de lista sale de PRICE_ARS en src/pages/desafio-30-dias/Desafio30DiasPage.tsx (se puede pisar con VITE_PACK_GAMES_REGULAR_PRICE).
VITE_PACK_GAMES_PRICE=10.000
# VITE_PACK_GAMES_REGULAR_PRICE=
# Oferta al pagar (sobre todo profesionales): "Cuadernillo extra, 40 fichas más". Ya existe (volumen 1, con 40 fichas nuevas):
# con VITE_PACK_EXTRA_AVAILABLE=1 se puede elegir; con la variable vacía se muestra como "Próximamente" y no se puede elegir.
VITE_PACK_EXTRA_PRICE=4.990
VITE_PACK_EXTRA_AVAILABLE=1
# Días de garantía.
VITE_PACK_GUARANTEE_DAYS=10
# Fin de la promo de lanzamiento (AAAA-MM-DD). Vacío = no se muestra ninguna promo. Solo la línea de aviso:
# el precio no cambia solo; la línea desaparece sola pasada la fecha, y conviene subir el precio en ese momento.
VITE_PACK_PROMO_END=

# ── OBLIGATORIOS PARA PUBLICAR (hoy vacíos: su espacio se oculta) ──
# Destino del formulario de compra de las dos landings: la URL completa del backend, https://<backend>/packs/checkout
# (recibe un POST de formulario con email, nombre, telefono, edicion, extras, utm_* y responde 303 a Mercado Pago).
# Vacío = no hay formulario: los botones bajan a la sección de precio, como en la vista previa. PENDIENTE hasta que el backend esté en producción.
VITE_PACK_CHECKOUT_URL=
# Contacto: enlace de WhatsApp (https://wa.me/54911XXXXXXXX) o mailto:, y el texto que se ve en el pie.
VITE_PACK_CONTACT_URL=
VITE_PACK_CONTACT_TEXT=
# Página del Botón de arrepentimiento (Resolución 424/2020 de la Secretaría de Comercio Interior): la página propia del sitio.
VITE_PACK_REGRET_URL=/arrepentimiento
# Razón social y CUIT (y domicilio, si corresponde) de quien vende.
VITE_PACK_LEGAL_ENTITY=
# Qué permite la licencia de uso (una línea, texto plano). Responde "¿Puedo imprimir las fichas más de una vez?".
VITE_PACK_LICENSE_FAMILIAS=
VITE_PACK_LICENSE_PROFESIONALES=
VITE_PACK_LICENSE_CUADERNOS=
# Cómo se pide factura (profesionales).
VITE_PACK_INVOICE_TEXT=

# ── Recomendados (sin ellos la página usa un texto neutro) ──
# Nombre y foto de la tallerista (la foto: ruta a un archivo de public/, con su consentimiento). Con el nombre, la página dice
# que ella escribe y revisa las guías: poner el nombre SOLO cuando esa revisión sea cierta.
VITE_PACK_TALLERISTA_NAME=
VITE_PACK_TALLERISTA_PHOTO=

# ID del Pixel de Meta (solo números). Vacío = no se carga ningún script de Meta.
VITE_META_PIXEL_ID=

# PACK_STRICT=1 hace fallar el build si falta un dato obligatorio o sigue prendido VITE_PACK_PREVIEW.
# Activarlo solo en el entorno de producción de Vercel, cuando estén listos.

# Solo para desarrollo, nunca en producción: con VITE_PACK_MOCK=1 las páginas /pack/gracias, /pack/descargas/:token, /pack/recuperar y /arrepentimiento
# responden con datos de ejemplo sin backend (tokens de prueba: mock-paid, mock-full, mock-pending, mock-cash, mock-failed, mock-review, mock-lost).
VITE_PACK_MOCK=

# Publica la vista previa de las landings del pack en producción (decisión del dueño, 2026-10-13).
# Sacar esta línea cuando el cobro esté listo: sin ella, el build de producción falla mientras queden datos provisorios.
VITE_PACK_PUBLISH_PREVIEW=1
